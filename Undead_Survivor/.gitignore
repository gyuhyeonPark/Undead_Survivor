/Assets/StreamingAssets/aa/
/Assets/StreamingAssets/com.unity.addressables/
/Library/
/Temp/
/Obj/
/Logs/

# 사용자 환경 설정 파일
/[Uu]ser[Ss]ettings/
/*.userprefs

# 비주얼 스튜디오 파일 (사용 중이면 필요에 따라 무시)
/*.csproj
/*.sln
/*.suo
/*.tmp
/*.user
/*.unityproj
/*.dll
/*.exe
/*.pdb
/*.mdb
/.vs/
/.vscode/

